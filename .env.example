# Copy to .env and adjust. All optional.

# Host folder your agents work in (mounted at /workspaces).
# PANTHEON_WORKSPACES=C:\Users\me\code

# audio.cpp server, as seen from the backend container.
# PANTHEON_VOICE_BASE_URL=http://host.docker.internal:8080

# Absolute host path of ./data/voice. audio.cpp's VAD reads audio from files,
# so it must be able to open the clips the backend writes there.
# PANTHEON_VOICE_SHARE_HOST_DIR=C:\path\to\Pantheon\data\voice

# Addresses the HTTPS proxy serves (comma separated), for using Pantheon
# (and its microphone) from a phone on your network.
# PANTHEON_HTTPS_SITES=https://localhost:3711, https://192.168.1.20:3711
# The IP phones will browse to (browsers send no SNI for IP addresses).
# PANTHEON_HTTPS_DEFAULT_SNI=192.168.1.20

# Database credentials. Set these before the first start: Postgres keeps
# whatever it was initialised with, so changing them later needs a fresh volume.
# POSTGRES_USER=pantheon
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=pantheon

# Published host ports (the containers' own ports never change).
# PANTHEON_WEB_PORT=3710        # the UI
# PANTHEON_BACKEND_PORT=8710    # API + WebSockets (the browser connects here directly)
# PANTHEON_HTTPS_PORT=3711      # HTTPS proxy for phones
# PANTHEON_DB_PORT=5433         # Postgres, for tools on this machine
# PANTHEON_DB_BIND=127.0.0.1    # set to 0.0.0.0 to expose Postgres to your network

# Browser origins allowed to call the API (defaults to localhost on PANTHEON_WEB_PORT).
# PANTHEON_CORS_ORIGINS=http://localhost:3710,http://192.168.1.20:3710

# Computer-use sandbox (docker compose --profile computer up -d).
# PANTHEON_COMPUTER_URL=http://desktop:8000
# PANTHEON_DESKTOP_PORT=6901          # noVNC live view
# PANTHEON_COMPUTER_PORT=8711         # computer-server API for a backend outside Docker
# PANTHEON_DESKTOP_RESOLUTION=1280x720
