{
  "manifest_version": 3,
  "name": "Pantheon Shadow",
  "version": "1.0.0",
  "description": "Record how you do your work in the browser so a Pantheon agent can learn to do it. Never records passwords or card numbers.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }],
  "action": { "default_popup": "popup.html", "default_title": "Pantheon Shadow" }
}
