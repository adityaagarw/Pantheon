# Pantheon backend configuration (all variables are prefixed PANTHEON_).
PANTHEON_DATABASE_URL=postgresql+asyncpg://pantheon:pantheon@localhost:5433/pantheon

# Where Pantheon keeps its own data (secrets key, MCP logs).
PANTHEON_DATA_DIR=../data

# Host folders agents may work in (semicolon separated). Every organization's
# workspace must be inside one of these; agents can never leave them.
PANTHEON_WORKSPACE_ROOTS=../data/workspaces

# Concurrency and resilience
PANTHEON_MAX_CONCURRENT_TURNS=8
PANTHEON_MAX_TURN_FAILURES=5

# Voice: a local audio.cpp server (audiocpp_server, OpenAI-compatible audio API)
PANTHEON_VOICE_BASE_URL=http://localhost:8080
PANTHEON_VOICE_STT_MODEL=
PANTHEON_VOICE_TTS_MODEL=

PANTHEON_CORS_ORIGINS=http://localhost:3710
